{
  "entities": {
    "StaffMember": {
      "title": "StaffMember",
      "description": "Authorized practice staff member and RBAC role assignment.",
      "type": "object",
      "properties": {
        "staffId": { "type": "string", "maxLength": 32, "description": "Unique staff code e.g. STF-001" },
        "staffName": { "type": "string", "maxLength": 120, "description": "Full display name" },
        "email": { "type": "string", "minLength": 0, "maxLength": 160, "description": "Staff sign-in email (may be empty string for Admin-created placeholder profiles until Google email is assigned)" },
        "role": { "type": "string", "enum": ["Admin", "Manager-HOD", "Staff", "Report Viewer"], "description": "RBAC role" },
        "active": { "type": "boolean", "description": "Whether staff account is active" },
        "noLogin": { "type": "boolean", "description": "Optional flag marking non-login pool/system accounts" },
        "department": { "type": "string", "maxLength": 80, "description": "Tax department" },
        "designation": { "type": "string", "maxLength": 80, "description": "Job title" },
        "phone": { "type": "string", "maxLength": 40, "description": "Contact phone" },
        "joinDate": { "type": "string", "maxLength": 20, "description": "Employment join date (YYYY-MM-DD)" },
        "leaveDate": { "type": "string", "maxLength": 20, "description": "Employment leave / resign date (YYYY-MM-DD)" },
        "uid": { "type": "string", "maxLength": 128, "description": "Linked Firebase Auth UID" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["staffId", "staffName", "email", "role", "active", "createdAt", "updatedAt"]
    },
    "SettingValue": {
      "title": "SettingValue",
      "description": "Controlled lookup value and status badge color for TPMS modules.",
      "type": "object",
      "properties": {
        "group": { "type": "string", "maxLength": 64, "description": "Setting group identifier" },
        "code": { "type": "string", "maxLength": 64, "description": "Machine code" },
        "displayName": { "type": "string", "maxLength": 120, "description": "Human-readable label" },
        "module": { "type": "string", "minLength": 0, "maxLength": 64, "description": "Target TPMS module (optional)" },
        "badgeColor": { "type": "string", "maxLength": 16, "pattern": "^#[0-9a-fA-F]{6}$", "description": "Hex color for status badge" },
        "active": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["group", "code", "displayName", "module", "badgeColor", "active", "sortOrder", "createdAt", "updatedAt"]
    },
