rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net — default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Core Primitives & Identity Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.size() > 3
        && request.auth.token.email.size() <= 160
        && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function staffKey() {
      return request.auth.token.email.lower().replace('[^a-z0-9]', '_');
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'tjwang.tax@gmail.com';
    }

    function staffDocExists() {
      return exists(/databases/$(database)/documents/staff/$(staffKey()));
    }

    function getStaffDoc() {
      return get(/databases/$(database)/documents/staff/$(staffKey())).data;
    }

    function isActiveStaff() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        (staffDocExists() && getStaffDoc().active == true)
      );
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        (staffDocExists() && getStaffDoc().active == true && getStaffDoc().role == 'Admin')
      );
    }

    function isManagerOrAdmin() {
      return isAdmin() || (
        isVerifiedUser() &&
        staffDocExists() &&
        getStaffDoc().active == true &&
        getStaffDoc().role == 'Manager-HOD'
      );
    }

    function isWorkingStaff() {
      return isManagerOrAdmin() || (
        isVerifiedUser() &&
        staffDocExists() &&
        getStaffDoc().active == true &&
        getStaffDoc().role == 'Staff'
      );
    }

    function optStr(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function optNum(data, field) {
      return !(field in data) || (data[field] is number && data[field] >= -999999999 && data[field] <= 999999999999);
    }

    function optBoundedMapList(data, field, maxItems) {
      return !(field in data) || (
        data[field] is list &&
        data[field].size() <= maxItems &&
        (data[field].size() == 0 || data[field][0] is map)
      );
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Pillar 2)
    // -------------------------------------------------------------------------
    function isValidStaff(data) {
      return data.keys().hasAll(['staffId', 'staffName', 'email', 'role', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['staffId', 'staffName', 'email', 'role', 'active', 'department', 'designation', 'phone', 'uid', 'createdAt', 'updatedAt'])
        && data.staffId is string && data.staffId.size() >= 1 && data.staffId.size() <= 32
        && data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.role in ['Admin', 'Manager-HOD', 'Staff', 'Report Viewer']
        && data.active is bool
        && optStr(data, 'department', 80)
        && optStr(data, 'designation', 80)
        && optStr(data, 'phone', 40)
        && optStr(data, 'uid', 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSetting(data) {
      return data.keys().hasAll(['group', 'code', 'displayName', 'module', 'badgeColor', 'active', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['group', 'code', 'displayName', 'module', 'badgeColor', 'active', 'sortOrder', 'createdAt', 'updatedAt'])
        && data.group is string && data.group.size() >= 1 && data.group.size() <= 64
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 64
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.module is string && data.module.size() >= 1 && data.module.size() <= 64
        && data.badgeColor is string && data.badgeColor.size() == 7 && data.badgeColor.matches('^#[0-9a-fA-F]{6}$')
        && data.active is bool
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 9999
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClient(data) {
      return data.keys().hasAll(['clientId', 'clientName', 'category', 'clientStatus', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'clientId', 'clientName', 'companyNo', 'tin', 'fye', 'taxPic', 'category',
          'clientStatus', 'smeStatus', 'taxAgent', 'myTaxAppointment', 'eInvoiceStatus',
          'sstRegistered', 'sstNo', 'email', 'phone', 'dateOfIncorporation',
          'dateOfCommencementBusiness', 'dateOfEngagement', 'dateOfResigned', 'auditor',
          'account', 'eNumber', 'specialRemarks', 'personNo', 'relationship',
          'engagementStatus', 'businessName', 'businessType', 'businessSsmNo',
          'businessENumber', 'businessStartDate', 'businessStatus', 'firstYa',
          'firstYaStatus', 'secondYa', 'secondYaStatus', 'groupId', 'companySecretary',
          'registeredAddress', 'businessHistory', 'relatedPersons', 'partnershipPartners',
          'yaMonitoring', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 40
        && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 200
        && data.category in ['Corporate', 'Individual', 'Other']
        && data.clientStatus is string && data.clientStatus.size() >= 1 && data.clientStatus.size() <= 60
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 160
        && optStr(data, 'updatedBy', 160)
        && optStr(data, 'companyNo', 60)
        && optStr(data, 'tin', 60)
        && optStr(data, 'fye', 10)
        && optStr(data, 'taxPic', 120)
        && optStr(data, 'smeStatus', 40)
        && optStr(data, 'taxAgent', 120)
        && optStr(data, 'myTaxAppointment', 60)
        && optStr(data, 'eInvoiceStatus', 60)
        && optStr(data, 'sstRegistered', 20)
        && optStr(data, 'sstNo', 60)
        && optStr(data, 'email', 160)
        && optStr(data, 'phone', 60)
        && optStr(data, 'dateOfIncorporation', 20)
        && optStr(data, 'dateOfCommencementBusiness', 20)
        && optStr(data, 'dateOfEngagement', 20)
        && optStr(data, 'dateOfResigned', 20)
        && optStr(data, 'auditor', 120)
        && optStr(data, 'account', 120)
        && optStr(data, 'eNumber', 60)
        && optStr(data, 'specialRemarks', 2000)
        && optStr(data, 'personNo', 60)
        && optStr(data, 'relationship', 80)
        && optStr(data, 'engagementStatus', 60)
        && optStr(data, 'businessName', 200)
        && optStr(data, 'businessType', 80)
        && optStr(data, 'businessSsmNo', 60)
        && optStr(data, 'businessENumber', 60)
        && optStr(data, 'businessStartDate', 20)
        && optStr(data, 'businessStatus', 60)
        && optStr(data, 'firstYa', 20)
        && optStr(data, 'firstYaStatus', 60)
        && optStr(data, 'secondYa', 20)
        && optStr(data, 'secondYaStatus', 60)
        && optStr(data, 'groupId', 60)
        && optStr(data, 'companySecretary', 120)
        && optStr(data, 'registeredAddress', 500)
        && optBoundedMapList(data, 'businessHistory', 50)
        && optBoundedMapList(data, 'relatedPersons', 50)
        && optBoundedMapList(data, 'partnershipPartners', 50)
        && optBoundedMapList(data, 'yaMonitoring', 50)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJob(data) {
      return data.keys().hasAll(['jobCode', 'module', 'clientId', 'clientName', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'jobCode', 'module', 'clientDocId', 'clientId', 'clientName', 'groupId', 'fye', 'ya',
          'taxPic', 'reviewer', 'status', 'priority', 'dueDate', 'completedDate', 'feeAmount',
          'billedAmount', 'billingStatus', 'hoursSpent', 'remarks', 'formType', 'submissionDate',
          'eFilingAckNo', 'taxPayable', 'taxRefundable', 'cp204Estimate', 'cp204Revised6th',
          'cp204Revised9th', 'cp204Revised11th', 'cp204InstallmentStart', 'paymentType',
          'installmentNo', 'amountDue', 'amountPaid', 'paymentDate', 'receiptNo',
          'correspondenceType', 'letterRefNo', 'letterDate', 'responseDueDate',
          'responseSentDate', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.jobCode is string && data.jobCode.size() >= 1 && data.jobCode.size() <= 40
        && data.module in ['CP204', 'Corporate', 'Individual', 'Ad Hoc', 'Form E', 'Tax Payment Monitor', 'Correspondence']
        && data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 40
        && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 200
        && data.status is string && data.status.size() >= 1 && data.status.size() <= 60
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 160
        && optStr(data, 'clientDocId', 128)
        && optStr(data, 'updatedBy', 160)
        && optStr(data, 'groupId', 60)
        && optStr(data, 'fye', 10)
        && optStr(data, 'ya', 16)
        && optStr(data, 'taxPic', 120)
        && optStr(data, 'reviewer', 120)
        && optStr(data, 'priority', 30)
        && optStr(data, 'dueDate', 20)
        && optStr(data, 'completedDate', 20)
        && optNum(data, 'feeAmount')
        && optNum(data, 'billedAmount')
        && optStr(data, 'billingStatus', 40)
        && optNum(data, 'hoursSpent')
        && optStr(data, 'remarks', 2000)
        && optStr(data, 'formType', 40)
        && optStr(data, 'submissionDate', 20)
        && optStr(data, 'eFilingAckNo', 80)
        && optNum(data, 'taxPayable')
        && optNum(data, 'taxRefundable')
        && optNum(data, 'cp204Estimate')
        && optNum(data, 'cp204Revised6th')
        && optNum(data, 'cp204Revised9th')
        && optNum(data, 'cp204Revised11th')
        && optStr(data, 'cp204InstallmentStart', 20)
        && optStr(data, 'paymentType', 60)
        && optStr(data, 'installmentNo', 20)
        && optNum(data, 'amountDue')
        && optNum(data, 'amountPaid')
        && optStr(data, 'paymentDate', 20)
        && optStr(data, 'receiptNo', 80)
        && optStr(data, 'correspondenceType', 80)
        && optStr(data, 'letterRefNo', 80)
        && optStr(data, 'letterDate', 20)
        && optStr(data, 'responseDueDate', 20)
        && optStr(data, 'responseSentDate', 20)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCalendarEvent(data) {
      return data.keys().hasAll(['title', 'eventType', 'startDate', 'endDate', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'eventType', 'startDate', 'endDate', 'assignedTo', 'clientId', 'clientName', 'notes', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.eventType is string && data.eventType.size() >= 1 && data.eventType.size() <= 40
        && data.startDate is string && data.startDate.size() >= 1 && data.startDate.size() <= 20
        && data.endDate is string && data.endDate.size() >= 1 && data.endDate.size() <= 20
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 160
        && optStr(data, 'assignedTo', 120)
        && optStr(data, 'clientId', 40)
        && optStr(data, 'clientName', 200)
        && optStr(data, 'notes', 1000)
        && optStr(data, 'updatedBy', 160)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['type', 'title', 'message', 'authorEmail', 'authorName', 'authorRole', 'targetRole', 'readBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['type', 'title', 'message', 'authorEmail', 'authorName', 'authorRole', 'targetRole', 'readBy', 'createdAt', 'updatedAt'])
        && data.type in ['announcement', 'suggestion', 'system']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 2000
        && data.authorEmail is string && data.authorEmail.size() >= 3 && data.authorEmail.size() <= 160
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && data.authorRole is string && data.authorRole.size() >= 1 && data.authorRole.size() <= 40
        && data.targetRole in ['ALL', 'Admin', 'Manager-HOD']
        && data.readBy is list && data.readBy.size() <= 100
        && (data.readBy.size() == 0 || data.readBy[0] is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // 1. Staff Directory & RBAC Master
    match /staff/{sKey} {
      allow get: if isVerifiedUser() && isValidId(sKey) && (sKey == staffKey() || isActiveStaff());
      allow list: if isActiveStaff();
      allow create: if isVerifiedUser()
        && isValidId(sKey)
        && isValidStaff(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(sKey)
        && isValidStaff(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (sKey == staffKey()
            && existing().active == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'updatedAt'])
            && incoming().uid == request.auth.uid)
        );
      allow delete: if isVerifiedUser() && isValidId(sKey) && isAdmin();
    }

    // 2. Controlled Values & Status Settings
    match /settings/{settingId} {
      allow get: if isActiveStaff() && isValidId(settingId);
      allow list: if isActiveStaff();
      allow create: if isVerifiedUser()
        && isValidId(settingId)
        && isValidSetting(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(settingId)
        && isValidSetting(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['group', 'code', 'displayName', 'module', 'badgeColor', 'active', 'sortOrder', 'updatedAt'])
        && isAdmin();
      allow delete: if isVerifiedUser() && isValidId(settingId) && isAdmin();
    }

    // 3. Client Master (40 fields + 4 relational schedules)
    match /clients/{clientDocId} {
      allow get: if isActiveStaff() && isValidId(clientDocId);
      allow list: if isActiveStaff();
      allow create: if isVerifiedUser()
        && isValidId(clientDocId)
        && isValidClient(incoming())
        && incoming().createdBy == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isWorkingStaff();
      allow update: if isVerifiedUser()
        && isValidId(clientDocId)
        && isValidClient(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time
        && (
          isManagerOrAdmin() ||
          (isWorkingStaff()
            && incoming().clientStatus == existing().clientStatus
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'clientId', 'clientName', 'companyNo', 'tin', 'fye', 'taxPic', 'category',
              'smeStatus', 'taxAgent', 'myTaxAppointment', 'eInvoiceStatus', 'sstRegistered',
              'sstNo', 'email', 'phone', 'dateOfIncorporation', 'dateOfCommencementBusiness',
              'dateOfEngagement', 'auditor', 'account', 'eNumber', 'specialRemarks', 'personNo',
              'relationship', 'engagementStatus', 'businessName', 'businessType', 'businessSsmNo',
              'businessENumber', 'businessStartDate', 'businessStatus', 'firstYa', 'firstYaStatus',
              'secondYa', 'secondYaStatus', 'groupId', 'companySecretary', 'registeredAddress',
              'businessHistory', 'relatedPersons', 'partnershipPartners', 'yaMonitoring',
              'updatedBy', 'updatedAt'
            ]))
        );
      allow delete: if isVerifiedUser() && isValidId(clientDocId) && isAdmin();
    }

    // 4. Unified Tax Compliance Jobs
    match /jobs/{jobId} {
      allow get: if isActiveStaff() && isValidId(jobId);
      allow list: if isActiveStaff();
      allow create: if isVerifiedUser()
        && isValidId(jobId)
        && isValidJob(incoming())
        && incoming().createdBy == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isWorkingStaff();
      allow update: if isVerifiedUser()
        && isValidId(jobId)
        && isValidJob(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time
        && (
          isManagerOrAdmin() ||
          (isWorkingStaff()
            && existing().status != 'Completed'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'jobCode', 'module', 'clientDocId', 'clientId', 'clientName', 'groupId', 'fye', 'ya',
              'taxPic', 'reviewer', 'status', 'priority', 'dueDate', 'completedDate', 'feeAmount',
              'billedAmount', 'billingStatus', 'hoursSpent', 'remarks', 'formType', 'submissionDate',
              'eFilingAckNo', 'taxPayable', 'taxRefundable', 'cp204Estimate', 'cp204Revised6th',
              'cp204Revised9th', 'cp204Revised11th', 'cp204InstallmentStart', 'paymentType',
              'installmentNo', 'amountDue', 'amountPaid', 'paymentDate', 'receiptNo',
              'correspondenceType', 'letterRefNo', 'letterDate', 'responseDueDate',
              'responseSentDate', 'updatedBy', 'updatedAt'
            ]))
        );
      allow delete: if isVerifiedUser() && isValidId(jobId) && isManagerOrAdmin();
    }

    // 5. Team Calendar Events
    match /calendarEvents/{eventId} {
      allow get: if isActiveStaff() && isValidId(eventId);
      allow list: if isActiveStaff();
      allow create: if isVerifiedUser()
        && isValidId(eventId)
        && isValidCalendarEvent(incoming())
        && incoming().createdBy == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isWorkingStaff();
      allow update: if isVerifiedUser()
        && isValidId(eventId)
        && isValidCalendarEvent(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().createdBy == existing().createdBy
        && incoming().updatedAt == request.time
        && (
          isManagerOrAdmin() ||
          (isWorkingStaff()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'eventType', 'startDate', 'endDate', 'assignedTo',
              'clientId', 'clientName', 'notes', 'updatedBy', 'updatedAt'
            ]))
        );
      allow delete: if isVerifiedUser() && isValidId(eventId) && isManagerOrAdmin();
    }

    // 6. Notifications (Announcements & Staff Suggestions)
    match /notifications/{notificationId} {
      allow get: if isActiveStaff() && isValidId(notificationId);
      allow list: if isActiveStaff();
      allow create: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().authorEmail == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().type == 'announcement' && isManagerOrAdmin()) ||
          (incoming().type == 'suggestion' && isWorkingStaff()) ||
          (incoming().type == 'system' && isAdmin())
        );
      allow update: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().authorEmail == existing().authorEmail
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isWorkingStaff()
            && incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(notificationId) && isAdmin();
    }
  }
}
