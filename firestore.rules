rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net — default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Core Primitives & Identity Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.size() > 3
        && request.auth.token.email.size() <= 160
        && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function userEmailLower() {
      return request.auth.token.email.lower();
    }

    // Sanitized email document ID (e.g. tjwang_tax_gmail_com)
    function staffKey() {
      return userEmailLower().replace('[^a-z0-9]', '_');
    }

    // STF_* document ID candidates (e.g. STF_EC, STF_CMY, STF_tjwang_tax_gmail_com)
    function stfEmailKey() {
      return 'STF_' + staffKey();
    }

    function stfPrefixUpperKey() {
      return 'STF_' + userEmailLower().split('@')[0].upper().replace('[^A-Z0-9]', '_');
    }

    // Bootstrapped primary firm Admin fallback (always gated by isVerifiedUser())
    function isBootstrappedAdmin() {
      return userEmailLower() == 'tjwang.tax@gmail.com';
    }

    function staffDocMatchesRole(d, roles) {
      return d.active == true
        && d.email is string
        && d.email.lower() == userEmailLower()
        && d.role in roles;
    }

    function staffIdHasRole(docId, roles) {
      return exists(/databases/$(database)/documents/staff/$(docId))
        && staffDocMatchesRole(get(/databases/$(database)/documents/staff/$(docId)).data, roles);
    }

    // Role lookup against /staff/{docId}: checks bootstrapped Admin, sanitized email key, and STF_* keys
    function hasRole(roles) {
      return isBootstrappedAdmin()
        || staffIdHasRole(staffKey(), roles)
        || staffIdHasRole(stfPrefixUpperKey(), roles)
        || staffIdHasRole(stfEmailKey(), roles);
    }

    // All active staff roles (including Report Viewer — read-only access)
    function isActiveStaff() {
      return isVerifiedUser() && hasRole(['Admin', 'Manager-HOD', 'Staff', 'Report Viewer']);
    }

    // Active working staff roles (excludes Report Viewer)
    function isWorkingStaff() {
      return isVerifiedUser() && hasRole(['Admin', 'Manager-HOD', 'Staff']);
    }

    function isManagerOrAdmin() {
      return isVerifiedUser() && hasRole(['Admin', 'Manager-HOD']);
    }

    function isAdmin() {
      return isVerifiedUser() && hasRole(['Admin']);
    }

    // -------------------------------------------------------------------------
    // Entity Validation Helpers
    // -------------------------------------------------------------------------

    // Strict validation on Staff Directory (blocks password fields and enforces valid roles)
    function isValidStaff(d) {
      let k = d.keys();
      return k.hasAll(['staffId', 'staffName', 'email', 'role', 'active'])
        && k.hasOnly([
          'staffId', 'staffName', 'email', 'role', 'active', 'noLogin',
          'department', 'designation', 'phone', 'uid', 'createdAt', 'updatedAt'
        ])
        && !k.hasAny(['password', 'passwordHash', 'passwordSalt'])
        && d.staffId is string && d.staffId.size() >= 1 && d.staffId.size() <= 32
        && d.staffName is string && d.staffName.size() >= 1 && d.staffName.size() <= 120
        && d.email is string && (d.email == '' || (d.email.size() >= 3 && d.email.size() <= 160))
        && d.role in ['Admin', 'Manager-HOD', 'Staff', 'Report Viewer']
        && d.active is bool
        && (!('noLogin' in d) || d.noLogin is bool)
        && (!('department' in d) || (d.department is string && d.department.size() <= 80))
        && (!('designation' in d) || (d.designation is string && d.designation.size() <= 80))
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 40))
        && (!('uid' in d) || (d.uid is string && d.uid.size() <= 128))
        && (!('createdAt' in d) || d.createdAt is timestamp)
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    function isValidSetting(d) {
      return d.keys().hasAll(['group', 'code', 'displayName'])
        && d.group is string && d.group.size() >= 1 && d.group.size() <= 64
        && d.code is string && d.code.size() >= 1 && d.code.size() <= 64
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 160;
    }

    // Core-identifier validation for Practice Data Collections
    // (Permits additional/legacy columns and Excel numeric fields without fragile hasOnly blocks)
    function isValidClient(d) {
      return d.keys().hasAll(['clientId', 'clientName'])
        && d.clientId is string && d.clientId.size() >= 1 && d.clientId.size() <= 80
        && d.clientName is string && d.clientName.size() >= 1 && d.clientName.size() <= 240;
    }

    function isValidJob(d) {
      return d.keys().hasAll(['jobCode', 'clientId', 'clientName'])
        && d.jobCode is string && d.jobCode.size() >= 1 && d.jobCode.size() <= 80
        && d.clientId is string && d.clientId.size() >= 1 && d.clientId.size() <= 80
        && d.clientName is string && d.clientName.size() >= 1 && d.clientName.size() <= 240;
    }

    function isValidCp204(d) {
      return d.keys().hasAll(['cp204Id', 'clientId', 'clientName'])
        && d.cp204Id is string && d.cp204Id.size() >= 1 && d.cp204Id.size() <= 80
        && d.clientId is string && d.clientId.size() >= 1 && d.clientId.size() <= 80
        && d.clientName is string && d.clientName.size() >= 1 && d.clientName.size() <= 240;
    }

    function isValidTaxPayment(d) {
      return d.keys().hasAll(['paymentId', 'clientId', 'clientName'])
        && d.paymentId is string && d.paymentId.size() >= 1 && d.paymentId.size() <= 80
        && d.clientId is string && d.clientId.size() >= 1 && d.clientId.size() <= 80
        && d.clientName is string && d.clientName.size() >= 1 && d.clientName.size() <= 240;
    }

    function isValidCorrespondence(d) {
      return d.keys().hasAll(['correspondenceId', 'clientId', 'clientName'])
        && d.correspondenceId is string && d.correspondenceId.size() >= 1 && d.correspondenceId.size() <= 80
        && d.clientId is string && d.clientId.size() >= 1 && d.clientId.size() <= 80
        && d.clientName is string && d.clientName.size() >= 1 && d.clientName.size() <= 240;
    }

    function isValidWorkDone(d) {
      return d.keys().hasAll(['workDoneId', 'clientId', 'clientName'])
        && d.workDoneId is string && d.workDoneId.size() >= 1 && d.workDoneId.size() <= 80
        && d.clientId is string && d.clientId.size() >= 1 && d.clientId.size() <= 80
        && d.clientName is string && d.clientName.size() >= 1 && d.clientName.size() <= 240;
    }

    function isValidCalendarEvent(d) {
      return d.keys().hasAll(['title', 'startDate'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 200
        && d.startDate is string && d.startDate.size() >= 1 && d.startDate.size() <= 30;
    }

    function isValidHistory(d) {
      return d.keys().hasAll(['jobId', 'action'])
        && d.jobId is string && d.jobId.size() >= 1 && d.jobId.size() <= 128
        && d.action is string && d.action.size() >= 1 && d.action.size() <= 100;
    }

    function isValidNotification(d) {
      let k = d.keys();
      return k.hasAll(['type', 'title', 'message', 'authorEmail', 'authorName', 'authorRole', 'targetRole', 'readBy', 'createdAt', 'updatedAt'])
        && k.hasOnly(['type', 'title', 'message', 'authorEmail', 'authorName', 'authorRole', 'targetRole', 'readBy', 'createdAt', 'updatedAt'])
        && d.type in ['announcement', 'suggestion', 'system']
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 160
        && d.message is string && d.message.size() >= 1 && d.message.size() <= 2000
        && d.authorEmail is string && d.authorEmail.size() >= 3 && d.authorEmail.size() <= 160
        && d.authorName is string && d.authorName.size() >= 1 && d.authorName.size() <= 120
        && d.authorRole is string && d.authorRole.size() >= 1 && d.authorRole.size() <= 40
        && d.targetRole in ['ALL', 'Admin', 'Manager-HOD']
        && d.readBy is list && d.readBy.size() <= 100
        && (d.readBy.size() == 0 || d.readBy[0] is string)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // 1. Staff Directory & RBAC Master (Strict field & role protection)
    match /staff/{sKey} {
      allow get: if isVerifiedUser() && isValidId(sKey) && (
        sKey == staffKey()
        || sKey == stfPrefixUpperKey()
        || sKey == stfEmailKey()
        || isActiveStaff()
      );
      allow list: if isActiveStaff();
      allow create: if isVerifiedUser()
        && isValidId(sKey)
        && isValidStaff(incoming())
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(sKey)
        && isValidStaff(incoming())
        && (
          isAdmin() ||
          ((sKey == staffKey() || sKey == stfPrefixUpperKey() || sKey == stfEmailKey())
            && existing().active == true
            && existing().email is string
            && existing().email.lower() == userEmailLower()
            && incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'updatedAt'])
            && incoming().uid == request.auth.uid)
        );
      allow delete: if isVerifiedUser() && isValidId(sKey) && isAdmin();
    }

    // 2. Controlled Values & Status Settings
    match /settings/{settingId} {
      allow get: if isActiveStaff() && isValidId(settingId);
      allow list: if isActiveStaff();
      allow create, update: if isVerifiedUser()
        && isValidId(settingId)
        && isValidSetting(incoming())
        && isManagerOrAdmin();
      allow delete: if isVerifiedUser() && isValidId(settingId) && isAdmin();
    }

    // 3. Client Master
    match /clients/{clientDocId} {
      allow get: if isActiveStaff() && isValidId(clientDocId);
      allow list: if isActiveStaff();
      allow create, update: if isVerifiedUser()
        && isValidId(clientDocId)
        && isValidClient(incoming())
        && (isAdmin() || isWorkingStaff());
      allow delete: if isVerifiedUser() && isValidId(clientDocId) && isAdmin();
    }

    // 4. Unified Tax Compliance Jobs
    match /jobs/{jobId} {
      allow get: if isActiveStaff() && isValidId(jobId);
      allow list: if isActiveStaff();
      allow create, update: if isVerifiedUser()
        && isValidId(jobId)
        && isValidJob(incoming())
        && (isAdmin() || isWorkingStaff());
      allow delete: if isVerifiedUser() && isValidId(jobId) && isManagerOrAdmin();
    }

    // 5. Immutable Job Audit History (Append-Only)
    match /history/{historyId} {
      allow get: if isActiveStaff() && isValidId(historyId);
      allow list: if isActiveStaff();
      allow create: if isVerifiedUser()
        && isValidId(historyId)
        && isValidHistory(incoming())
        && (isAdmin() || isWorkingStaff());
      allow update, delete: if false;
    }

    // 6. Team Calendar Events
    match /calendarEvents/{eventId} {
      allow get: if isActiveStaff() && isValidId(eventId);
      allow list: if isActiveStaff();
      allow create, update: if isVerifiedUser()
        && isValidId(eventId)
        && isValidCalendarEvent(incoming())
        && (isAdmin() || isWorkingStaff());
      allow delete: if isVerifiedUser() && isValidId(eventId) && isManagerOrAdmin();
    }

    // 7. Notifications (Announcements & Staff Suggestions)
    match /notifications/{notificationId} {
      allow get: if isActiveStaff() && isValidId(notificationId);
      allow list: if isActiveStaff();
      allow create: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().authorEmail.lower() == userEmailLower()
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (incoming().type == 'announcement' && isManagerOrAdmin()) ||
          (incoming().type == 'suggestion' && isWorkingStaff()) ||
          (incoming().type == 'system' && isAdmin())
        );
      allow update: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().authorEmail == existing().authorEmail
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (isWorkingStaff()
            && incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'updatedAt']))
        );
      allow delete: if isVerifiedUser() && isValidId(notificationId) && isAdmin();
    }

    // 8. CP204 Monitoring (Initial Estimates, CP204A Revisions & Instalments)
    match /cp204/{cp204DocId} {
      allow get: if isActiveStaff() && isValidId(cp204DocId);
      allow list: if isActiveStaff();
      allow create, update: if isVerifiedUser()
        && isValidId(cp204DocId)
        && isValidCp204(incoming())
        && (isAdmin() || isWorkingStaff());
      allow delete: if isVerifiedUser() && isValidId(cp204DocId) && isManagerOrAdmin();
    }

    // 9. Tax Payment Monitor
    match /taxPayments/{paymentDocId} {
      allow get: if isActiveStaff() && isValidId(paymentDocId);
      allow list: if isActiveStaff();
      allow create, update: if isVerifiedUser()
        && isValidId(paymentDocId)
        && isValidTaxPayment(incoming())
        && (isAdmin() || isWorkingStaff());
      allow delete: if isVerifiedUser() && isValidId(paymentDocId) && isManagerOrAdmin();
    }

    // 10. Correspondence Register
    match /correspondence/{correspondenceDocId} {
      allow get: if isActiveStaff() && isValidId(correspondenceDocId);
      allow list: if isActiveStaff();
      allow create, update: if isVerifiedUser()
        && isValidId(correspondenceDocId)
        && isValidCorrespondence(incoming())
        && (isAdmin() || isWorkingStaff());
      allow delete: if isVerifiedUser() && isValidId(correspondenceDocId) && isManagerOrAdmin();
    }

    // 11. Work Done & Finance
    match /workDone/{workDoneDocId} {
      allow get: if isActiveStaff() && isValidId(workDoneDocId);
      allow list: if isActiveStaff();
      allow create, update: if isVerifiedUser()
        && isValidId(workDoneDocId)
        && isValidWorkDone(incoming())
        && (isAdmin() || isWorkingStaff());
      allow delete: if isVerifiedUser() && isValidId(workDoneDocId) && isAdmin();
    }
  }
}
